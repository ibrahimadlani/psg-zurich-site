# -----------------------------------------------------------------------------
# PSG Zurich — environment variables
# Copy to `.env` for local development: cp .env.example .env
# In production (Infomaniak), set them in the Manager instead — never commit them.
# -----------------------------------------------------------------------------

# MariaDB/MySQL connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Local value matches docker-compose.yml. Special characters in the password must be URL-encoded.
DATABASE_URL=mysql://psg:psg@localhost:3306/psg_zurich

# Better Auth: random secret of 32+ characters (generate with: openssl rand -base64 32).
BETTER_AUTH_SECRET=change-me-with-openssl-rand-base64-32
# Public URL of the site, no trailing slash (production: https://psg-zurich.ch).
BETTER_AUTH_URL=http://localhost:3000

# SMTP — local: Mailpit from docker-compose.yml (no auth, UI on http://localhost:8025).
# Production (Infomaniak): SMTP_HOST=mail.infomaniak.com, SMTP_PORT=465 (SSL) or 587 (STARTTLS),
# SMTP_USER = full address of the sending mailbox, SMTP_PASSWORD = its password.
# Leave SMTP_HOST empty in development to print emails to the console instead.
# Next.js expands "$NAME" inside .env values, even between quotes: write a literal "$" as "\$".
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Sender and reply-to of every email. MAIL_FROM must be allowed by the SMTP account.
MAIL_FROM="PSG Zurich <noreply@psg-zurich.ch>"
MAIL_REPLY_TO=contact@psg-zurich.ch

# Optional. Shown by /api/health; defaults to the commit SHA injected by CI at build time.
APP_VERSION=

# Optional. Pending migrations are applied when the production server starts; set to "false" to disable.
MIGRATE_ON_START=true

# Production only: network interface of the standalone server (`node server.js`).
# PORT is injected by the host. Locally, `npm run dev` ignores both.
# HOSTNAME=0.0.0.0

# Optional. football-data.org key (https://www.football-data.org/client/register, free plan):
# imports PSG matches (Ligue 1, Champions League) and follows them live.
FOOTBALL_DATA_KEY=

# Google Maps Platform (browser key restricted to the site domains; inlined at build time)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID carrying the club map style (optional; Google demo style otherwise)
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Optional. Server key for the Routes API (driving time from a member's home to an event).
# Restrict it to "Routes API" only, without referrer restriction: it is never sent to browsers.
GOOGLE_ROUTES_API_KEY=

# Online payments (Stripe, test mode: sk_test_… / pk_test_…). Without them, payment is manual.
# The publishable key is inlined at build time (GitHub variable in production).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Signing secret of the webhook (/api/v1/payments/webhook); locally: `stripe listen`.
STRIPE_WEBHOOK_SECRET=
