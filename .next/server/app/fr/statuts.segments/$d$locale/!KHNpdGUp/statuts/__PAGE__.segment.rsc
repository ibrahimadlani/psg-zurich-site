,"$3","0",{"children":"tient la liste des membres et les comptes ;"}]]]}],["$","li","représente l'association auprès du Paris Saint-Germain, des autorités et des tiers ;",{"className":"relative pl-5","children":[["$","span",null,{"aria-hidden":true,"className":"absolute top-[0.7em] left-0 h-px w-2.5 bg-psg-red"}],[["$","$3","0",{"children":"représente l'association auprès du Paris Saint-Germain, des autorités et des tiers ;"}]]]}],["$","li","peut constituer des groupes de travail et adopter des règlements internes.",{"className":"relative pl-5","children":[["$","span",null,{"aria-hidden":true,"className":"absolute top-[0.7em] left-0 h-px w-2.5 bg-psg-red"}],[["$","$3","0",{"children":"peut constituer des groupes de travail et adopter des règlements internes."}]]]}]]}]]}]]}]
4d:["$","section","representation",{"id":"representation","aria-labelledby":"representation-title","className":"scroll-mt-8 border-b py-8 first:pt-0 last:border-b-0","children":[["$","h2",null,{"id":"representation-title","className":"mb-4 flex items-baseline gap-3 text-[20px] font-semibold tracking-tight","children":[["$","span",null,{"className":"shrink-0 font-mono text-[12px] font-normal text-psg-red","children":"Art. 17"}],"Représentation"]}],["$","div",null,{"className":"flex flex-col gap-4 text-[15px] leading-relaxed text-muted-foreground","children":[["$","p","0",{"children":[["$","$3","0",{"children":"L'association est valablement engagée par la signature collective à deux du président ou de la présidente et d'un autre membre du comité. Pour les affaires courantes, le comité peut accorder une signature individuelle jusqu'à un montant qu'il fixe."}]]}]]}]]}]
4e:["$","section","verificateurs",{"id":"verificateurs","aria-labelledby":"verificateurs-title","className":"scroll-mt-8 border-b py-8 first:pt-0 last:border-b-0","children":[["$","h2",null,{"id":"verificateurs-title","className":"mb-4 flex items-baseline gap-3 text-[20px] font-semibold tracking-tight","children":[["$","span",null,{"className":"shrink-0 font-mono text-[12px] font-normal text-psg-red","children":"Art. 18"}],"Vérificateurs des comptes"]}],["$","div",null,{"className":"flex flex-col gap-4 text-[15px] leading-relaxed text-muted-foreground","children":[["$","p","0",{"children":[["$","$3","0",{"children":"L'assemblée générale élit chaque année deux vérificateurs ou vérificatrices des comptes, qui ne font pas partie du comité. Ils contrôlent les comptes et présentent un rapport écrit à l'assemblée générale ordinaire."}]]}]]}]]}]
