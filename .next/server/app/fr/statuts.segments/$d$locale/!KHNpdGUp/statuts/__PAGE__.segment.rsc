4e:["$","section","decisions",{"id":"decisions","aria-labelledby":"decisions-title","className":"scroll-mt-8 border-b py-8 first:pt-0 last:border-b-0","children":[["$","h2",null,{"id":"decisions-title","className":"mb-4 flex items-baseline gap-3 text-[20px] font-semibold tracking-tight","children":[["$","span",null,{"className":"shrink-0 font-mono text-[12px] font-normal text-psg-red","children":"Art. 13"}],"Décisions"]}],["$","div",null,{"className":"flex flex-col gap-4 text-[15px] leading-relaxed text-muted-foreground","children":[["$","p","0",{"children":[["$","$3","0",{"children":"L'assemblée générale régulièrement convoquée délibère valablement quel que soit le nombre de membres présents. Chaque membre disposant du droit de vote a une voix ; le vote par procuration n'est pas admis."}]]}],["$","p","1",{"children":[["$","$3","0",{"children":"Les décisions et élections sont prises à la majorité simple des voix exprimées ; en cas d'égalité, la voix du président ou de la présidente est prépondérante. La modification des statuts et la dissolution requièrent la majorité des deux tiers des voix exprimées."}]]}],["$","p","2",{"children":[["$","$3","0",{"children":"Les votes ont lieu à main levée, ou à bulletin secret si un cinquième des membres présents le demande. Les décisions font l'objet d'un procès-verbal signé par le président ou la présidente et par le ou la secrétaire."}]]}]]}]]}]
4f:["$","section","assemblee-extraordinaire",{"id":"assemblee-extraordinaire","aria-labelledby":"assemblee-extraordinaire-title","className":"scroll-mt-8 border-b py-8 first:pt-0 last:border-b-0","children":[["$","h2",null,{"id":"assemblee-extraordinaire-title","className":"mb-4 flex items-baseline gap-3 text-[20px] font-semibold tracking-tight","children":[["$","span",null,{"className":"shrink-0 font-mono text-[12px] font-normal text-psg-red","children":"Art. 14"}],"Assemblée générale extraordinaire"]}],["$","div",null,{"className":"flex flex-col gap-4 text-[15px] leading-relaxed text-muted-foreground","children":[["$","p","0",{"children":[["$","$3","0",{"children":"Une assemblée générale extraordinaire est convoquée par le comité chaque fois qu'il le juge nécessaire, ou à la demande écrite d'un cinquième des membres disposant du droit de vote. Dans ce dernier cas, elle se tient dans les 6 semaines suivant la demande."}]]}]]}]]}]
50:["$","section","comite",{"id":"comite","aria-labelledby":"comite-title","className":"scroll-mt-8 border-b py-8 first:pt-0 last:border-b-0","children":[["$","h2",null,{"id":"comite-title","className":"mb-4 flex items-baseline gap-3 text-[20px] font-semibold tracking-tight","children":[["$","span",null,{"className":"shrink-0 font-mono text-[12px] font-normal text-psg-red","children":"Art. 15"}],"Comité"]}],["$","div",null,{"className":"flex flex-col gap-4 text-[15px] leading-relaxed text-muted-foreground","children":[["$","p","0",{"children":[["$","$3","0",{"children":"Le comité se compose de [5] à [9] membres élus par l'assemblée générale pour deux ans et rééligibles. Il comprend au moins un président ou une présidente, un ou une secrétaire et un trésorier ou une trésorière ; pour le reste, il se constitue lui-même."}]]}],["$","p","1",{"children":[["$","$3","0",{"children":"Le comité se réunit aussi souvent que les affaires l'exigent, sur convocation de son président ou de sa présidente ou à la demande de deux de ses membres. Il délibère valablement lorsque la majorité de ses membres est présente, y compris à distance ; ses décisions sont prises à la majorité simple."}]]}],["$","p","2",{"children":[["$","$3","0",{"children":"Les membres du comité agissent bénévolement. Leurs frais effectifs peuvent être remboursés sur justificatif."}]]}]]}]]}]
