47:["$","section","assemblee-generale",{"id":"assemblee-generale","aria-labelledby":"assemblee-generale-title","className":"scroll-mt-8 border-b py-8 first:pt-0 last:border-b-0","children":[["$","h2",null,{"id":"assemblee-generale-title","className":"mb-4 flex items-baseline gap-3 text-[20px] font-semibold tracking-tight","children":[["$","span",null,{"className":"shrink-0 font-mono text-[12px] font-normal text-psg-red","children":"Art. 11"}],"Assemblée générale"]}],["$","div",null,{"className":"flex flex-col gap-4 text-[15px] leading-relaxed text-muted-foreground","children":[["$","p","0",{"children":[["$","$3","0",{"children":"L'assemblée générale est l'organe suprême de l'association. Elle se réunit en séance ordinaire une fois par an, au plus tard [fin septembre]."}]]}],["$","p","1",{"children":[["$","$3","0",{"children":"Elle est convoquée par le comité au moins 20 jours à l'avance, par e-mail ou par tout autre moyen écrit. La convocation indique l'ordre du jour. Les propositions des membres doivent parvenir au comité au moins 10 jours avant l'assemblée."}]]}],["$","p","2",{"children":[["$","$3","0",{"children":"L'assemblée peut se tenir en présentiel, en ligne ou sous forme mixte, à condition que l'identité des participants et l'exercice du droit de vote soient garantis."}]]}]]}]]}]
