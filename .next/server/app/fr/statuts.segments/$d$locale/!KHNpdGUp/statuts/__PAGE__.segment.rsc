ldren":"Exonérés"}]]}]]}]]}],["$","p","2",{"children":[["$","$3","0",{"children":"La cotisation est due pour l'exercice en cours, quelle que soit la date d'admission. Elle n'est pas remboursée en cas de démission ou d'exclusion."}]]}]]}]]}]
