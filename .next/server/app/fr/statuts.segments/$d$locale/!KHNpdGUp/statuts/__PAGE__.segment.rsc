50:["$","section","responsabilite",{"id":"responsabilite","aria-labelledby":"responsabilite-title","className":"scroll-mt-8 border-b py-8 first:pt-0 last:border-b-0","children":[["$","h2",null,{"id":"responsabilite-title","className":"mb-4 flex items-baseline gap-3 text-[20px] font-semibold tracking-tight","children":[["$","span",null,{"className":"shrink-0 font-mono text-[12px] font-normal text-psg-red","children":"Art. 20"}],"Responsabilité"]}],["$","div",null,{"className":"flex flex-col gap-4 text-[15px] leading-relaxed text-muted-foreground","children":[["$","p","0",{"children":[["$","$3","0",{"children":"Les engagements de l'association sont garantis uniquement par sa fortune sociale. Toute responsabilité personnelle des membres est exclue au-delà du paiement de la cotisation."}]]}]]}]]}]
51:["$","section","billetterie",{"id":"billetterie","aria-labelledby":"billetterie-title","className":"scroll-mt-8 border-b py-8 first:pt-0 last:border-b-0","children":[["$","h2",null,{"id":"billetterie-title","className":"mb-4 flex items-baseline gap-3 text-[20px] font-semibold tracking-tight","children":[["$","span",null,{"className":"shrink-0 font-mono text-[12px] font-normal text-psg-red","children":"Art. 21"}],"Billetterie et déplacements"]}],["$","div",null,{"className":"flex flex-col gap-4 text-[15px] leading-relaxed text-muted-foreground","children":[["$","p","0",{"children":[["$","$3","0",{"children":"Les billets obtenus par l'intermédiaire de l'association sont nominatifs et réservés aux membres à jour de leur cotisation. Leur revente, en particulier à un prix supérieur à leur valeur faciale, est interdite et peut entraîner l'exclusion."}]]}],["$","p","1",{"children":[["$","$3","0",{"children":"Lors des déplacements organisés, chaque membre respecte les consignes des organisateurs et les règlements des stades. Il répond personnellement de son comportement et des dommages qu'il cause."}]]}]]}]]}]
52:["$","section","relations-psg",{"id":"relations-psg","aria-labelledby":"relations-psg-title","className":"scroll-mt-8 border-b py-8 first:pt-0 last:border-b-0","children":[["$","h2",null,{"id":"relations-psg-title","className":"mb-4 flex items-baseline gap-3 text-[20px] font-semibold tracking-tight","children":[["$","span",null,{"className":"shrink-0 font-mono text-[12px] font-normal text-psg-red","children":"Art. 22"}],"Relations avec le Paris Saint-Germain"]}],["$","div",null,{"className":"flex flex-col gap-4 text-[15px] leading-relaxed text-muted-foreground","children":[["$","p","0",{"children":[["$","$3","0",{"children":"L'association est un club de supporters officiel du Paris Saint-Germain. Elle respecte le cahier des charges des clubs de supporters officiels et utilise le nom, l'écusson et les marques du club dans les limites autorisées par celui-ci."}]]}],["$","p","1",{"children":[["$","$3","0",{"children":"L'association reste juridiquement et financièrement indépendante du Paris Saint-Germain Football Club."}]]}]]}]]}]
