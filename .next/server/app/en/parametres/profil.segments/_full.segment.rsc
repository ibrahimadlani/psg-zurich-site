d by Paris Saint-Germain.","club":"The club","join":"Join us","contact":"Contact","location":"Zurich, Switzerland","official":"Official PSG Supporters Club","imprint":"Legal notice","privacy":"Privacy","statutes":"Statutes"},"Emails":{"resetPassword":{"subject":"Choose your password — PSG Zurich","preview":"Your link to choose a new password","heading":"New password","body":"Click the button below to choose your password. This link is valid for one hour.","cta":"Choose my password","ignore":"If you did not request this, simply ignore this email: your current password stays unchanged."},"verifyEmail":{"subject":"Confirm your email — PSG Zurich","preview":"One last step to activate your account","heading":"Welcome to PSG Zurich","body":"Just one click left: the button below confirms your email address, activates your account and takes you to the site. This link is valid for 24 hours.","cta":"Get started","ignore":"If you did not create an account, simply ignore this email."},"membershipRequest":{"subject":"New membership request: {name}","preview":"{name} wants to join the club","heading":"New membership request","body":"{name} ({email}, {city}) has just confirmed their address and wants to join the club. Accept or refuse the request from the administration.","cta":"View the request","footer":"You receive this email as a PSG Zurich administrator."},"membershipApproved":{"subject":"Welcome to PSG Zurich!","preview":"Your membership is accepted","heading":"Welcome, {firstName}!","body":"The committee has accepted your membership request. Your member number is **{number}**. Next step: pay this season's fee to access events, from your member area.","cta":"Go to my member area","footer":"A question? Write to us at <mail></mail>."},"membershipRejected":{"subject":"Your membership request — PSG Zurich","preview":"Reply to your membership request","heading":"Hello {firstName},","body":"After review, the committee was unable to accept your membership request. In accordance with the statutes, you may appeal to the next general assembly.","footer":"For any question or to appeal, write to us at <mail></mail>."},"accountDeleted":{"subject":"Your account has been deleted — PSG Zurich","preview":"Confirmation that your account was deleted","heading":"Account deleted","body":"As requested, your PSG Zurich account and member data have been permanently deleted. You are welcome to join again at any time from the website.","footer":"If you did not request this, write to us immediately at <mail></mail>."},"waitlistPromoted":{"subject":"A place freed up: {event}","preview":"You are signed up for {event}","heading":"Good news, {firstName}!","body":"A place freed up for \"{event}\": you move from the waitlist to the confirmed list. If you can no longer come, cancel to give the place to someone else.","cta":"See the event","footer":"A question? Write to us at <mail></mail>."},"newEvent":{"subject":"New event: {event}","preview":"{event} — {date}","heading":"{event}","body":"Hello {firstName}, the club is organising \"{event}\" on {date} ({place}). Sign up soon, places are limited.","cta":"See the event and sign up","footer":"You receive this email because event announcements are on in your settings."},"predictionReminder":{"subject":"24 hours left to predict {match}","preview":"Kick-off {time}","heading":"Your prediction, {firstName}?","body":"{match} ({competition}) kicks off {time} and you haven't predicted yet. Predictions close at kick-off.","cta":"Predict now","footer":"You receive this reminder because it is on in your settings."},"changeEmail":{"subject":"Confirm your email change — PSG Zurich","preview":"New address: {newEmail}","heading":"Email address change","body":"You asked to replace your account's address with {newEmail}. Confirm with the button below: we will then send a verification link to the new address.","cta":"Confirm the change","ignore":"If you did not request this, ignore this email and change your password: your current address stays unchanged."},"common":{"unsubscribe":"Unsubscribe from these emails"},"membershipReceived":{"subject":"Membership request received — PSG Zurich","preview":"The committee is reviewing your request","heading":"Thank you, {firstName}!","body":"Your address is confirmed and your membership request has reached the committee. You'll get an email as soon as it has been reviewed, usually within a few days.\n\nMeanwhile, have a look at the club's news.","cta":"Visit the site","footer":"A question? Write to us at <mail></mail>."},"verifyReminder":{"subject":"Confirm your address to complete your membership","preview":"Your request is waiting for your email confirmation","heading":"One more step, {firstName}","body":"Your membership request only reaches the committee once your email address is confirmed. The first link may have expired: **sign in** and a new link is sent right away.","cta":"Sign in","footer":"If you did not request this, ignore this email."},"committeeDigest":{"subject":"{count, plural, one {# membership request has} other {# membership requests have}} been waiting over 3 days","preview":"{names}","heading":"Requests waiting","body":"{count, plural, one {This request has} other {These requests have}} been waiting for a committee decision for over 3 days: **{names}**.","cta":"See the requests","footer":"Daily summary sent to admins while requests are waiting."},"completeProfile":{"subject":"Complete your profile, {firstName}","preview":"Phone and address: so the committee can reach you","heading":"A complete profile is better","body":"Add your phone and address in your settings: the committee can then reach you about trips, tickets and events.","cta":"Complete my profile"},"feeReminder":{"subject":"Your membership fee for the season — PSG Zurich","preview":"Pay the fee to access events","heading":"Hello {firstName},","body":"Your membership is accepted; all that's left is this season's fee (**{fee}**) to see the events programme and sign up.","cta":"Pay my fee","footer":"Already paid? The committee records payments within a few days. A question: <mail></mail>."},"feeReceipt":{"subject":"Fee received — thank you!","preview":"You're covered until {until}","heading":"Thank you, {firstName}!","body":"The committee has received your fee. You're covered until **{until}**: the events programme and sign-ups are open.","cta":"See the events","footer":"Keep this email as your receipt."},"feeRenewal":{"subject":"Renewing your membership fee — PSG Zurich","preview":"Your fee ends on {until}","heading":"The season is ending, {firstName}","body":"Your fee covers the season until **{until}**. Remember to renew it ({fee}) to keep access to events from 1 July.","cta":"Renew my fee"},"feeExpired":{"subject":"Your membership fee has expired","preview":"Renew it to keep access to events","heading":"Hello {firstName},","body":"Last season's fee has expired. Renew it ({fee}) to get the events programme and sign-ups back.","cta":"Renew my fee","footer":"A question? Write to us at <mail></mail>."},"eventAlmostFull":{"subject":"Only {left, plural, one {# spot} other {# spots}} left: {event}","preview":"{event} — {date}","heading":"Filling up!","body":"Only **{left, plural, one {# spot} other {# spots}}** left for “{event}” ({date}). Sign up soon.","cta":"Sign me up"},"eventReminder":{"subject":"Tomorrow: {event}","preview":"{date} · {place}","heading":"See you tomorrow, {firstName}!","body":"A quick reminder: you're signed up for “{event}”. Bring your **member card** (QR code in your member area): it is scanned at the entrance.\n\nCan't come anymore? Cancel your sign-up to free the spot.","cta":"See the event","footer":"A question? Write to us at <mail></mail>."},"eventCancelled":{"subject":"Event cancelled: {event}","preview":"{event} — {date}","heading":"Event cancelled","body":"Hello {firstName}, the event “{event}” planned on {date} is cancelled. Sorry! The club's next events are on the site.","cta":"See the events","footer":"A questio