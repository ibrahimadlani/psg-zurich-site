":"Saving failed. Try again."},"Notifications":{"label":"Notifications","labelUnread":"Notifications ({count} unread)","loading":"Loading…","empty":"Nothing new for now.","manage":"Manage notification emails","predictionBody":"PSG – {opponent}: make your call before kick-off.","pointsBody":"{count, plural, =0 {0 points} one {# point} other {# points}} on PSG – {opponent}","membershipBody":"Your membership has been accepted. Welcome to the club!","kinds":{"article":"New article","event":"New event","prediction":"Prediction to make","points":"Your prediction result","membership":"Membership"}},"LocaleSwitcher":{"label":"Language","fr":"Français","en":"English","de":"Deutsch"},"ThemeToggle":{"label":"Toggle theme","short":"Theme"},"Banner":{"close":"Hide announcement","learnMore":"Learn more"},"ComingSoon":{"eyebrow":"Under construction","title":"Coming soon","body":"The website of the official Paris Saint-Germain supporters club in Zurich is on its way. In the meantime, get in touch:"},"Login":{"title":"Sign in","body":"Access your member area.","email":"Email address","emailPlaceholder":"first.last@example.ch","password":"Password","forgot":"Forgot password?","submit":"Sign in","submitting":"Signing in…","noAccount":"Not a member yet?","join":"Join","showPassword":"Show password","hidePassword":"Hide password","invalidEmail":"Invalid email address.","passwordRequired":"Enter your password.","invalidCredentials":"Incorrect email or password.","welcome":"Welcome back, {name}!","error":"Sign-in is unavailable right now. Please try again later.","notVerified":"Please confirm your email address first: we just sent you a new link.","linkInvalid":"This confirmation link is no longer valid. Sign in to get a new one."},"ForgotPassword":{"title":"Forgot password","body":"Enter your email address and we'll send you a link to choose a new password.","submit":"Send the link","submitting":"Sending…","backToLogin":"Back to sign in","sentTitle":"Email sent","sentBody":"If an account