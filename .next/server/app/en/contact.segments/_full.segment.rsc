":"No accepted members yet.","others":"Nobody here."},"pills":{"toReview":"To review","unverified":"Email not confirmed","paid":"Paid","unpaid":"Fee due"},"statuses":{"pending":"Pending request","active":"Active member","expired":"Expired","suspended":"Suspended","rejected":"Refused"},"pickTitle":"Pick a member","pickBody":"Their file opens here: contact, fee, events and history.","back":"All members","approvePaid":"Accept + fee received","approveOnly":"Accept only","approved":"Membership accepted.","approvedPaid":"Membership accepted and fee recorded.","remindVerify":"Remind to confirm","verifyReminded":"Reminder sent (at most one a day).","reject":"Refuse","rejectTitle":"Refuse {name}?","rejectBody":"They are told by email and may appeal to the general assembly.","rejectReason":"Reason (committee only, optional)","rejectReasonHint":"E.g. does not live in Switzerland","rejected":"Request refused.","cancelDues":"Cancel the fee","cancelDuesTitle":"Cancel the fee?","cancelDuesBody":"{name} will lose access to events until the next payment.","duesCancelled":"Fee cancelled.","recordDues":"Fee received","duesRecorded":"Fee recorded.","remindFee":"Remind","feeReminded":"Fee reminder sent (at most one a day).","edit":"Edit","suspend":"Suspend","suspendTitle":"Suspend {name}?","suspendBody":"The member keeps the account but loses access to members-only content and events.","suspended":"Member suspended.","reactivate":"Reinstate","reactivated":"Member reinstated.","undo":"Undo","error":"That didn't work. Reload the page and try again.","editTitle":"Edit member","editHint":"Correct the details. Personal choices (interests, photos) stay with the member.","editError":"Check the fields in red.","saved":"Changes saved.","cancel":"Cancel","save":"Save","birthDate":"Date of birth","emailLanguage":"Email language","sections":{"contact":"Contact","membership":"Membership","profile":"Profile","events":"Events","history":"History"},"fields":{"email":"Email","phone":"Phone","address":"A