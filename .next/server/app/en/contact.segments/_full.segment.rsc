 member","member_fee_reminder":"sent a fee reminder","member_verify_reminder":"sent an email confirmation reminder","member_export":"exported members","member_create":"created a member file","member_signup":"membership request","member_profile_update":"updated their profile","member_settings_update":"changed their settings","event_create":"created the event","event_update":"edited the event","event_delete":"deleted the event","event_export":"exported the sign-ups","event_checkin":"scanned someone in","event_attendee_checkin":"checked in","event_attendee_uncheck":"undid a check-in","event_attendee_promote":"gave a place","event_attendee_remove":"removed a sign-up","event_attendee_add":"signed up","match_create":"added the match","match_update":"edited the match","match_delete":"deleted the match","match_sync":"synced the matches","post_create":"created the article","post_update":"edited the article","post_delete":"deleted the article","announcement_create":"published the announcement","announcement_activate":"put the announcement live","announcement_deactivate":"hid the announcement","announcement_delete":"deleted the announcement","poll_create":"created the poll","poll_open":"opened the poll","poll_closed":"closed the poll","poll_draft":"put the poll back in draft","poll_delete":"deleted the poll","document_create":"added the document","document_update":"edited the document","document_delete":"deleted the document","mailing_campaign_send":"sent the campaign","mailing_campaign_schedule":"scheduled the campaign","mailing_campaign_unschedule":"unscheduled the campaign","mailing_template_save":"edited an email template","mailing_settings_update":"changed the sending settings","mailing_automation_update":"changed an automation","mailing_run":"ran the sending","user_role_change":"changed a role","user_delete":"account deleted","subscriber_create":"new newsletter subscriber","prediction_reward":"handed over a predictions prize","prediction_rewardUndo":"undid a predictions prize hand-over","contact_reply":"replied to the message","contact_note":"added an internal note","contact_assign":"assigned the message","contact_closed":"closed the message","contact_open":"took up the message","contact_answered":"marked the message as answered","contact_spam":"marked the message as spam","contact_new":"put the message back to handle","contact_delete":"deleted the message","member_committeeTitle":"changed a committee role"}},"AdminShell":{"label":"Admin navigation","home":"Admin home","badge":"Admin","site":"View site","toggle":"Collapse or expand the menu","collapse":"Collapse","more":"More","close":"Close","groups":{"club":"Club","programme":"Programme","content":"Content","team":"Team"},"sections":{"home":"Home","members":"Members","dues":"Fees","events":"Events","news":"News","mailing":"Mailing","banner":"Banner","settings":"Settings","matches":"Matches","scanner":"Scanner","polls":"Polls","documents":"Documents","journal":"Log","messages":"Messages"},"tabs":{"home":"Home","members":"Members","dues":"Fees","events":"Events","news":"News","mailing":"Mailing","banner":"Banner","settings":"Settings","matches":"Matches","scanner":"Scan","polls":"Polls","documents":"Docs","journal":"Log","messages":"Messages"},"roles":{"member":"Member","moderator":"Moderator","admin":"Admin","superadmin":"Superadmin"},"confirm":{"cancel":"Cancel","confirm":"Confirm","typeToConfirm":"Type “{text}” to confirm"},"palette":{"title":"Quick search","short":"Search…","placeholder":"Member, event, article, section…","sections":"Sections","empty":"No results.","messages":"Messages"}},"AdminBanner":{"published":"Announcement published.","title":"Announcement banner","description":"Message shown at the top of every page. Only one announcement is live at a time; publishing an active one replaces the previous.","tone":"Type","tones":{"info":"Information","maintenance":"Maintenance","urgent":"Urgent"},"titleFr":"Title (FR)","messageFr":"Message (FR)","titlePlaceholder":"Site en maintenance","messagePlaceholder":"One short sentence, on one line.","translations":"Translations (optional, French is shown otherwise)","titleEn":"Title (EN)","messageEn":"Message (EN)","titleDe":"Title (DE)","messageDe":"Message (DE)","linkUrl":"\"Learn more\" link (optional)","endsAt":"Stop showing at (optional)","activeNow":"Show immediately","publish":"Publish","saving":"Publishing…","error":"The announcement could not be saved.","invalid":"Check the fields: French title and message are required, link must be valid.","status":{"live":"Live","off":"Off","expired":"Expired"},"activate":"Activate","deactivate":"Deactivate","delete":"Delete","confirmDelete":"Permanently delete this announcement?","empty":"No announcements yet.","preview":"Preview","new":"New announcement","activated":"Announcement live.","deactivated":"Announcement hidden.","undo":"Undo","liveTitle":"Live","noneLive":"No announcement live.","historyTitle":"History"},"NotFound":{"title":"Page not found.","body":"The link may be wrong, or the page has been moved or deleted.","backHome":"Back to home"},"ServerError":{"title":"Something went wrong.","body":"It's not you, it's us: this page could not be displayed. Try again in a moment. If the problem persists, write to us at <mail></mail>.","retry":"Try again","backHome":"Back to home","reference":"Reference: {digest}"},"Footer":{"tagline":"Official supporters club, certified by Paris Saint-Germain.","club":"The club","join":"Join us","contact":"Contact","location":"Zurich, Switzerland","official":"Official PSG Supporters Club","imprint":"Legal notice","privacy":"Privacy","statutes":"Statutes","legal":"Official documents","instagram":"Instagram"},"Emails":{"resetPassword":{"subject":"Choose your password — PSG Zurich","preview":"Your link to choose a new password","heading":"New password","body":"Click the button below to choose your password. This link is valid for one hour.","cta":"Choose my password","ignore":"If you did not request this, simply ignore this email: your current password stays unchanged."},"verifyEmail":{"subject":"Confirm your email — PSG Zurich","preview":"One last step to activate your account","heading":"Welcome to PSG Zurich","body":"Just one click left: the button below confirms your email address, activates your account and takes you to the site. This link is valid for 24 hours.","cta":"Get started","ignore":"If you did not create an account, simply ignore this email."},"membershipRequest":{"subject":"New membership request: {name}","preview":"{name} wants to join the club","heading":"New membership request","body":"{name} ({email}, {city}) has just confirmed their address and wants to join the club. Accept or refuse the request from the administration.","cta":"View the request","footer":"You receive this email as a PSG Zurich administrator."},"membershipApproved":{"subject":"Welcome to PSG Zurich!","preview":"Your membership is accepted","heading":"Welcome, {firstName}!","body":"The committee has accepted your membership request. Your member number is **{number}**. Next step: pay this season's fee to access events, from your member area.","cta":"Go to my member area","footer":"A question? Write to us at <mail></mail>."},"membershipRejected":{"subject":"Your membership request — PSG Zurich","preview":"Reply to your membership request","heading":"Hello {firstName},","body":"After review, the committee was unable to accept your membership request. In accordance with the statutes, you may appeal to the next general assembly.","footer":"For any question or to appeal, write to us at <mail></mail>."},"accountDeleted":{"subject":"Your account has been deleted — PSG Zurich","preview":"Confirmation that your account was deleted","heading":"Account deleted","body":"As requested, your PSG Zurich account and member data have been permanently deleted. You are welcome to join again at any time from the website.","footer":"If you did not request this, write to us immediately at <mail></mail>."},"waitlistPromoted":{"subject":"A place freed up: {event}","preview":"You are signed up for {event}","heading":"Good news, {firstName}!","body":"A place freed up for \"{event}\": you move from the waitlist to the confirmed list. If you can no longer come, cancel to give the place to someone else.","cta":"See the event","footer":"A question? Write to us at <mail></mail>."},"newEvent":{"subject":"New event: {event}","preview":"{event} — {date}","heading":"{event}","body":"Hello {firstName}, the club is organising \"{event}\" on {date} ({place}). Sign up soon, places are limited.","cta":"See the event and sign up","footer":"You receive this email because event announcements are on in your settings."},"predictionReminder":{"subject":"24 hours left to predict {match}","preview":"Kick-off {time}","heading":"Your prediction, {firstName}?","body":"{match} ({competition}) kicks off {time} and you haven't predicted yet. Predictions close at kick-off.","cta":"Predict now","footer":"You receive this reminder because it is on in your settings."},"changeEmail":{"subject":"Confirm your email change — PSG Zurich","preview":"New address: {newEmail}","heading":"Email address change","body":"You asked to replace your account's address with {newEmail}. Confirm with the button below: we will then send a verification link to the new address.","cta":"Confirm the change","ignore":"If you did not request this, ignore this email and change your password: your current address stays unchanged."},"common":{"unsubscribe":"Unsubscribe from these emails"},"membershipReceived":{"subject":"Membership request received — PSG Zurich","preview":"The committee is reviewing your request","heading":"Thank you, {firstName}!","body":"Your address is confirmed and your membership request has reached the committee. You'll get an email as soon as it has been reviewed, usually within a few days.\n\nMeanwhile, have a look at the club's news.","cta":"Visit the site","footer":"A question? Write to us at <mail></mail>."},"verifyReminder":{"subject":"Confirm your address to complete your membership","preview":"Your request is waiting for your email confirmation","heading":"One more step, {firstName}","body":"Your membership request only reaches the committee once your email address is confirmed. The first link may have expired: **sign in** and a new link is sent right away.","cta":"Sign in","footer":"If you did not request this, ignore this email."},"committeeDigest":{"subject":"{count, plural, one {# membership request has} other {# membership requests have}} been waiting over 3 days","preview":"{names}","heading":"Requests waiting","body":"{count, plural, one {This request has} other {These requests have}} been waiting for a committee decision for over 3 days: **{names}**.","cta":"See the requests","footer":"Daily summary sent to admins while requests are waiting."},"completeProfile":{"subject":"Complete your profile, {firstName}","preview":"Phone and address: so the committee can reach you","heading":"A complete profile is better","body":"Add your phone and address in your settings: the committee can then reach you about trips, tickets and events.","cta":"Complete my profile"},"feeReminder":{"subject":"Your membership fee for the season — PSG Zurich","preview":"Pay the fee to access events","heading":"Hello {firstName},","body":"Your membership is accepted; all that's left is this season's fee (**{fee}**) to see the events programme and sign up.","cta":"Pay my fee","footer":"Already paid? The committee records payments within a few days. A question: <mail></mail>."},"feeReceipt":{"subject":"Fee received — thank you!","preview":"You're covered until {until}","heading":"Thank you, {firstName}!","body":"The committee has received your fee. You're covered until **{until}**: the events programme and sign-ups are open.","cta":"See the events","footer":"Keep this email as your receipt."},"feeRenewal":{"subject":"Renewing your membership fee — PSG Zurich","preview":"Your fee ends on {until}","heading":"The season is ending, {firstName}","body":"Your fee covers the season until **{until}**. Remember to renew it ({fee}) to keep access to events from 1 July.","cta":"Renew my fee"},"feeExpired":{"subject":"Your membership fee has expired","preview":"Renew it to keep access to events","heading":"Hello {firstName},","body":"Last season's fee has expired. Renew it ({fee}) to get the events programme and sign-ups back.","cta":"Renew my fee","footer":"A question? Write to us at <mail></mail>."},"eventAlmostFull":{"subject":"Only {left, plural, one {# spot} other {# spots}} left: {event}","preview":"{event} — {date}","heading":"Filling up!","body":"Only **{left, plural, one {# spot} other {# spots}}** left for “{event}” ({date}). Sign up soon.","cta":"Sign me up"},"eventReminder":{"subject":"Tomorrow: {event}","preview":"{date} · {place}","heading":"See you tomorrow, {firstName}!","body":"A quick reminder: you're signed up for “{event}”. Bring your **member card** (QR code in your member area): it is scanned at the entrance.\n\nCan't come anymore? Cancel your sign-up to free the spot.","cta":"See the event","footer":"A question? Write to us at <mail></mail>."},"eventCancelled":{"subject":"Event cancelled: {event}","preview":"{event} — {date}","heading":"Event cancelled","body":"Hello {firstName}, the event “{event}” planned on {date} is cancelled. Sorry! The club's next events are on the site.","cta":"See the events","footer":"A question? Write to us at <mail></mail>."},"eventThanks":{"subject":"Thanks for coming: {event}","preview":"It was great to see you","heading":"Thank you, {firstName}!","body":"Thanks for being there for “{event}”. Photos and the story are coming soon in the club news.","cta":"See the news"},"predictionResult":{"subject":"{points, plural, =0 {0 points} one {# point} other {# points}} on {match}","preview":"Score {score} · your prediction {prediction}","heading":"{points, plural, =0 {No points this time} one {+# point} other {+# points}}, {firstName}","body":"**{match}** ended **{score}** (regulation time). Your prediction: {prediction}.","cta":"See the leaderboard"},"leaderboardMonthly":{"subject":"Your {month}: #{rank} of {total}","preview":"{points} points in the predictions leaderboard","heading":"{month} recap","body":"You finished **#{rank} of {total}** in the {month} predictions leaderboard, with **{points, plural, =0 {0 points} one {# point} other {# points}}**. New month, new chance!","cta":"See the leaderboard"},"inactive":{"subject":"The club misses you, {firstName}","preview":"Predictions, events, news","heading":"It's been a while!","body":"Predictions go on, new events are coming and the club has news to share. Come and see us again!","cta":"Back to the site"},"seasonWinner":{"subject":"{rank, select, 1 {{season} predictions champion!} other {On the {season} predictions podium!}}","preview":"#{rank} in the final table, {points} points","heading":"{rank, select, 1 {Season champion} 2 {2nd of the season} other {3rd of the season}}","body":"The {season} season is over and the predictions table is now final: you finish **#{rank}** with **{points, plural, one {# point} other {# points}}**. Well done! Your trophy now shows next to your name on the site, and the committee will be in touch to hand over your prize.","cta":"See the final table"},"seasonPodium":{"subject":"{season} predictions: the final podium","preview":"{podium}","heading":"Season {season} closed","body":"The {season} predictions table is final. Here is the podium to reward: **{podium}**. Mark each prize as handed over in the admin, under Matches.","cta":"Open the podiums","footer":"Sent once, when the season closes."},"contactReceived":{"subject":"Message received · {reference}","preview":"The committee replies within 24 hours","heading":"We've received your message","body":"Hello {firstName},\n\nThanks for your message ({topic, select, join {joining} events {events and away trips} fees {fee and card} partnership {partnership, press} website {problem with the site} account {personal data} other {other question}}). The committee replies within 24 hours. Your reference: **{reference}**.\n\nAs a reminder, here is what you wrote:","cta":"Follow my request","footer":"You're receiving this email because you wrote to PSG Zurich from the Contact page."},"contactToCommittee":{"subject":"{followUp, select, yes {New reply} other {New message}} · {reference} · {name}","preview":"{topic, select, join {joining} events {events and away trips} fees {fee and card} partnership {partnership, press} website {problem with the site} account {personal data} other {other question}}","heading":"{followUp, select, yes {{name} replied} other {New message from {name}}}","body":"**{name}** ({email}) {followUp, select, yes {replied in request} other {wrote to the club, request}} **{reference}**, topic: {topic, select, join {joining} events {events and away trips} fees {fee and card} partnership {partnership, press} website {problem with the site} account {personal data} other {other question}}.\n\nReply from the admin so the conversation stays tracked. Replying to this email writes to {email} without recording it in the admin.","cta":"Reply in the admin","footer":"Sent to the committee members who read this topic."},"contactReply":{"subject":"The committee replied · {reference}","preview":"Reply to your request {reference}","heading":"The committee's reply","body":"Hello {firstName},\n\nHere is the committee's reply to your request **{reference}**:","cta":"View and reply","footer":"To reply, use the button above: your answer goes straight to the committee."},"contactReminder":{"subject":"{count, plural, one {# message has} other {# messages have}} been waiting over 24 h","preview":"{references}","heading":"Messages waiting","body":"{count, plural, one {This request has} other {These requests have}} been waiting for a reply for over 24 hours: **{references}**.\n\nThe Contact page promises a reply within 24 h.","cta":