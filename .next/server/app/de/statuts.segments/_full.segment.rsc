53:["$","section","representation",{"id":"representation","aria-labelledby":"representation-title","className":"scroll-mt-8 border-b py-8 first:pt-0 last:border-b-0","children":[["$","h2",null,{"id":"representation-title","className":"mb-4 flex items-baseline gap-3 text-[20px] font-semibold tracking-tight","children":[["$","span",null,{"className":"shrink-0 font-mono text-[12px] font-normal text-psg-red","children":"Art. 17"}],"Représentation"]}],["$","div",null,{"className":"flex flex-col gap-4 text-[15px] leading-relaxed text-muted-foreground","children":[["$","p","0",{"children":[["$","$1","0",{"children":"L'association est valablement engagée par la signature collective à deux du président ou de la présidente et d'un autre membre du comité. Pour les affaires courantes, le comité peut accorder une signature individuelle jusqu'à un montant qu'il fixe."}]]}]]}]]}]
54:["$","section","verificateurs",{"id":"verificateurs","aria-labelledby":"verificateurs-title","className":"scroll-mt-8 border-b py-8 first:pt-0 last:border-b-0","children":[["$","h2",null,{"id":"verificateurs-title","className":"mb-4 flex items-baseline gap-3 text-[20px] font-semibold tracking-tight","children":[["$","span",null,{"className":"shrink-0 font-mono text-[12px] font-normal text-psg-red","children":"Art. 18"}],"Vérificateurs des comptes"]}],["$","div",null,{"className":"flex flex-col gap-4 text-[15px] leading-relaxed text-muted-foreground","children":[["$","p","0",{"children":[["$","$1","0",{"children":"L'assemblée générale élit chaque année deux vérificateurs ou vérificatrices des comptes, qui ne font pas partie du comité. Ils contrôlent les comptes et présentent un rapport écrit à l'assemblée générale ordinaire."}]]}]]}]]}]
55:["$","section","exercice",{"id":"exercice","aria-labelledby":"exercice-title","className":"scroll-mt-8 border-b py-8 first:pt-0 last:border-b-0","children":[["$","h2",null,{"id":"exercice-title","className":"mb-4 flex items-baseline gap-3 text-[20px] font-semibold tracking-tight","children":[["$","span",null,{"className":"shrink-0 font-mono text-[12px] font-normal text-psg-red","children":"Art. 19"}],"Exercice et comptes"]}],["$","div",null,{"className":"flex flex-col gap-4 text-[15px] leading-relaxed text-muted-foreground","children":[["$","p","0",{"children":[["$","$1","0",{"children":"L'exercice social se termine le [30 juin] de chaque année. Le trésorier ou la trésorière tient les comptes et les présente au comité, puis aux vérificateurs."}]]}]]}]]}]
56:["$","section","responsabilite",{"id":"responsabilite","aria-labelledby":"responsabilite-title","className":"scroll-mt-8 border-b py-8 first:pt-0 last:border-b-0","children":[["$","h2",null,{"id":"responsabilite-title","className":"mb-4 flex items-baseline gap-3 text-[20px] font-semibold tracking-tight","children":[["$","span",null,{"className":"shrink-0 font-mono text-[12px] font-normal text-psg-red","children":"Art. 20"}],"Responsabilité"]}],["$","div",null,{"className":"flex flex-col gap-4 text-[15px] leading-relaxed text-muted-foreground","children":[["$","p","0",{"children":[["$","$1","0",{"children":"Les engagements de l'association sont garantis uniquement par sa fortune sociale. Toute responsabilité personnelle des membres est exclue au-delà du paiement de la cotisation."}]]}]]}]]}]
57:["$","section","billetterie",{"id":"billetterie","aria-labelledby":"billetterie-title","className":"scroll-mt-8 border-b py-8 first:pt-0 last:border-b-0","children":[["$","h2",null,{"id":"billetterie-title","className":"mb-4 flex items-baseline gap-3 text-[20px] font-semibold tracking-tight","children":[["$","span",null,{"className":"shrink-0 font-mono text-[12px] font-normal text-psg-red","children":"Art. 21"}],"Billetterie et déplacements"]}],["$","div",null,{"className":"flex flex-col gap-4 text-[15px] leading-relaxed text-muted-foreground","children":[["$","p","0",{"children":[["$","$1","0",{"children":"Les billets obtenus par l'intermédiaire de l'association sont nominatifs et réservés aux membres à jour de leur cotisation. Leur revente, en particulier à un prix supérieur à leur valeur faciale, est interdite et peut entraîner l'exclusion."}]]}],["$","p","1",{"children":[["$","$1","0",{"children":"Lors des déplacements organisés, chaque membre respecte les consignes des organisateurs et les règlements des stades. Il répond personnellement de son comportement et des dommages qu'il cause."}]]}]]}]]}]
58:["$","section","relations-psg",{"id":"relations-psg","aria-labelledby":"relations-psg-title","className":"scroll-mt-8 border-b py-8 first:pt-0 last:border-b-0","children":[["$","h2",null,{"id":"relations-psg-title","className":"mb-4 flex items-baseline gap-3 text-[20px] font-semibold tracking-tight","children":[["$","span",null,{"className":"shrink-0 font-mono text-[12px] font-normal text-psg-red","children":"Art. 22"}],"Relations avec le Paris Saint-Germain"]}],["$","div",null,{"className":"flex flex-col gap-4 text-[15px] leading-relaxed text-muted-foreground","children":[["$","p","0",{"children":[["$","$1","0",{"children":"L'association est un club de supporters officiel du Paris Saint-Germain. Elle respecte le cahier des charges des clubs de supporters officiels et utilise le nom, l'écusson et les marques du club dans les limites autorisées par celui-ci."}]]}],["$","p","1",{"children":[["$","$1","0",{"children":"L'association reste juridiquement et financièrement indépendante du Paris Saint-Germain Football Club."}]]}]]}]]}]
59:["$","section","donnees",{"id":"donnees","aria-labelledby":"donnees-title","className":"scroll-mt-8 border-b py-8 first:pt-0 last:border-b-0","children":[["$","h2",null,{"id":"donnees-title","className":"mb-4 flex items-baseline gap-3 text-[20px] font-semibold tracking-tight","children":[["$","span",null,{"className":"shrink-0 font-mono text-[12px] font-normal text-psg-red","children":"Art. 23"}],"Protection des données"]}],["$","div",null,{"className":"flex flex-col gap-4 text-[15px] leading-relaxed text-muted-foreground","children":[["$","p","0",{"children":[["$","$1","0",{"children":"L'association traite les données personnelles de ses membres uniquement pour la poursuite de ses buts, conformément à la loi fédérale sur la protection des données et à sa politique de confidentialité. Elle ne les transmet pas à des tiers, sauf au Paris Saint-Germain dans la mesure nécessaire à la billetterie et avec l'accord du membre concerné."}]]}]]}]]}]
