3b:["$","$L3c",null,{"formats":"$undefined","locale":"de","messages":{"Common":{"loading":"Wird geladen…"},"HumanDate":{"now":"jetzt","tomorrow":"morgen","yesterday":"gestern","tomorrowAt":"morgen um {time}","yesterdayAt":"gestern um {time}"},"Metadata":{"title":"PSG Zurich","description":"Offizieller Fanclub von Paris Saint-Germain in Zürich."},"Nav":{"label":"Hauptnavigation","home":"Start","news":"Aktuelles","matches":"Spiele","events":"Events","membership":"Mitglied werden","contact":"Kontakt","memberArea":"Mitgliederbereich","admin":"Administration","menu":"Menü","close":"Schließen","settings":"Einstellungen","drawer":{"nextMatch":"Nächstes Spiel","predict":"Tippen","see":"Ansehen","new":"Neuer Artikel","upcoming":"{count} bevorstehend","joinTitle":"Werde Mitglied","joinBody":"Watch-Partys, Auswärtsfahrten, Tipps: die PSG-Fangemeinde in Zürich.","signIn":"Anmelden","card":"Meine Karte","predictions":"Tipps","admin":"Admin","status":{"full":"Beitrag bezahlt","unpaid":"Beitrag offen","pending":"Wartet auf den Vorstand"},"theme":{"label":"Design","light":"Hell","dark":"Dunkel","system":"System"}},"shop":"Shop"},"EventsShowcase":{"kinds":{"watch_party":"Die grossen Spiele auf Grossleinwand in einer Zürcher Bar, unter Fans und in den Farben.","away_trip":"Mit Car oder Zug in den Parc des Princes und quer durch Europa, Tickets und Reise organisiert.","members_match":"Unsere eigenen Spiele unter Mitgliedern auf einem Platz in der Region: Alle spielen mit.","social":"Abende, Generalversammlung, Saisonabschlussessen: Zeit miteinander abseits der Spiele."}},"Contact":{"title":"Kontakt","hello":"Hallo {name}","intro":"Eine Frage zum Club, zur Mitgliedschaft, zu einer Auswärtsfahrt oder einer Partnerschaft? Schreib uns, der Vorstand antwortet.","memberIntro":"Eine Frage an den Vorstand? Wähl das Thema, wir antworten dir.","promise":"Antwort innert 24 h","copy":"Adresse kopieren","copied":"Adresse kopiert","byEmail":"Oder per E-Mail","mapLabel":"Karte von Zürich","location":"Zürich, Schweiz","openMap":"Google Maps","committeeBanner":"{count, plural, one {# Kontaktnachricht wartet auf den Vorstand.} other {# Kontaktnachrichten warten auf den Vorstand.}}","committeeBannerLink":"Posteingang öffnen","myMessages":"Meine Nachrichten","myMessagesOpen":"{count, plural, =0 {Keine offene Anfrage} one {# offene Anfrage} other {# offene Anfragen}}","pickTitle":"Du schreibst uns wegen…","help":{"join":"Die Mitgliedschaft läuft online und dauert 3 Minuten: Formular ausfüllen, dann bestätigt der Vorstand.","joinCta":"Jetzt beitreten","joinQuestion":"Ich habe vorher eine Frage","eventsVisitor":"Watch-Partys und Auswärtsfahrten sind für Mitglieder. Eine Frage vor dem Beitritt? Schreib uns.","eventsMember":"Anmelden kannst du dich direkt auf der Seite jedes Events.","eventsMemberCta":"Zu den Events","fees":"Betrag, Zahlungsarten und der Stand deines Beitrags stehen auf deiner Beitragsseite.","feesCta":"Mein Beitrag","account":"Du kannst alle deine Daten herunterladen oder dein Konto selbst löschen, in deinen Einstellungen.","accountCta":"Meine Einstellungen","website":"Schreib uns, was du gemacht hast und was passiert ist. Die betroffene Seite und dein Browser werden mitgeschickt.","partnership":"Bar, Sponsor, Medium oder anderer Club: Stell uns dein Projekt vor, wir melden uns rasch.","other":"Stell deine Frage, der Vorstand antwortet.","accountVisitor":"Auskunft, Berichtigung oder Löschung deiner Personendaten: Beschreib dein Anliegen, der Vorstand antwortet innert der gesetzlichen Fristen."},"form":{"name":"Name","namePlaceholder":"Vorname Name","email":"E-Mail","emailPlaceholder":"du@beispiel.ch","organisation":"Organisation","organisationPlaceholder":"Bar, Firma, Medium…","page":"Betroffene Seite","message":"Nachricht","messagePlaceholder":"Deine Nachricht…","chars":"{count} / 5000","tooShort":"Noch mindestens {count, plural, one {# Zeichen} other {# Zeichen}}.","required":"Pflichtfeld.","invalidEmail":"Ungültige E-Mail-Adresse.","sentAs":"Gesendet als {name} · {email}","privacy":"Deine Nachricht wird vom Vorstand gelesen und höchstens 2 Jahre nach Abschluss aufbewahrt. <link>Datenschutz</link>","send":"Senden","sending":"Wird gesendet…","changeTopic":"Thema ändern","draftRestored":"Entwurf wiederhergestellt","errors":{"generic":"Die Nachricht wurde nicht gesendet. Dein Text bleibt erhalten: versuch es nochmals.","tooFast":"Einen Moment… lies deine Nachricht nochmals und sende sie dann.","tooMany":"Zu viele Nachrichten gesendet. Versuch es in einer Stunde wieder.","retry":"Nochmals versuchen"}},"success":{"title":"Nachricht gesendet","reference":"Referenz","steps":{"email":"Eine Eingangsbestätigung geht an {email}.","answer":"Der Vorstand antwortet innert 24 h.","follow":"Verfolge die Anfrage und antworte über deinen persönlichen Link."},"stepsMember":{"email":"Eine Eingangsbestätigung geht an deine Adresse.","answer":"Der Vorstand antwortet innert 24 h.","follow":"Die Antwort kommt per E-Mail und unter «Meine Nachrichten»."},"follow":"Anfrage verfolgen","copyLink":"Link kopieren","linkCopied":"Link kopiert","another":"Weitere Nachricht schreiben"},"faqTitle":"Häufige Fragen","faq":[{"q":"Was kostet die Mitgliedschaft?","a":"Der Jahresbeitrag beträgt {fee} ({juniorFee} für unter 18-Jährige). Er gilt für die Saison vom 1. Juli bis 30. Juni."},{"q":"Verkauft der Club Tickets für PSG-Spiele?","a":"Nein. Tickets gibt es bei der offiziellen Ticketplattform von PSG. Der Club organisiert Auswärtsfahrten und teilt Tipps mit den Mitgliedern."},{"q":"Wie laufen die Watch-Partys ab?","a":"Mitglieder melden sich online an und zeigen am Eingang ihre Mitgliederkarte. Die Daten stehen in der Event-Agenda."},{"q":"Muss ich für Auswärtsfahrten Mitglied sein?","a":"Ja: Auswärtsfahrten und Events sind für Mitglieder mit bezahltem Beitrag."},{"q":"Wer kann Mitglied werden?","a":"Alle PSG-Fans, die in der Schweiz leben oder einen Bezug zur Schweiz haben. Du trittst online bei, der Vorstand bestätigt."},{"q":"Wie erhalte oder lös