{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?(?:\\/((?!api|_next|_vercel|brand\\/|robots\\.txt|sitemap\\.xml|icon\\.svg|favicon\\.ico).*))(\\.json|\\.rsc|\\.segments\\/.+\\.segment\\.rsc)?[\\/#\\?]?$",
          "originalSource": "/((?!api|_next|_vercel|brand/|robots\\.txt|sitemap\\.xml|icon\\.svg|favicon\\.ico).*)"
        }
      ]
    }
  }
}